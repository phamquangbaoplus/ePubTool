{
  "sourceLanguage": "en",
  "strings": {
    "%@: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@: %2$@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: %2$@"
          }
        }
      }
    },
    "%lld books · %lld selected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld books · %2$lld selected"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld sách · Đã chọn %2$lld"
          }
        }
      }
    },
    "%lld files have no unambiguous catalog match; showing filenames without reading file metadata.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld tệp không có kết quả khớp rõ ràng trong danh mục; đang hiển thị tên tệp mà không đọc siêu dữ liệu tệp."
          }
        }
      }
    },
    "%lld of %lld processed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld of %2$lld processed"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã xử lý %1$lld trên %2$lld"
          }
        }
      }
    },
    "Actions": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tác vụ"
          }
        }
      }
    },
    "Author": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tác giả"
          }
        }
      }
    },
    "Book declares encrypted resources. Repacking does not remove DRM.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sách khai báo tài nguyên đã mã hóa. Đóng gói lại không gỡ bỏ DRM."
          }
        }
      }
    },
    "Calibre ebook-edit was not found in /Applications/calibre.app.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy ebook-edit của Calibre trong /Applications/calibre.app."
          }
        }
      }
    },
    "Calibre exited with status %d.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Calibre đã thoát với mã trạng thái %d."
          }
        }
      }
    },
    "Cannot locate an accessible BKLibrary*.sqlite. Check that Apple Books is installed and ePubTool has Full Disk Access, then refresh. %@": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể định vị tệp BKLibrary*.sqlite có thể truy cập. Hãy kiểm tra xem Apple Books đã được cài đặt và ePubTool có Quyền truy cập toàn bộ đĩa chưa, sau đó làm mới. %@"
          }
        }
      }
    },
    "Cannot open Books database read-only: %@. Check file access permissions.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể mở cơ sở dữ liệu Books ở chế độ chỉ đọc: %@. Hãy kiểm tra quyền truy cập tệp."
          }
        }
      }
    },
    "Cannot read library: %@. Check that Apple Books is installed and ePubTool has Full Disk Access.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đọc thư viện: %@. Hãy kiểm tra xem Apple Books đã được cài đặt và ePubTool có Quyền truy cập toàn bộ đĩa chưa."
          }
        }
      }
    },
    "Checking iCloud availability: %@…": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang kiểm tra khả dụng iCloud: %@…"
          }
        }
      }
    },
    "Choose an export folder outside the Apple Books source folder.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một thư mục xuất nằm ngoài thư mục nguồn của Apple Books."
          }
        }
      }
    },
    "Choose an output folder outside the source book.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một thư mục đầu ra nằm ngoài sách nguồn."
          }
        }
      }
    },
