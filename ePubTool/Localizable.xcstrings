    "Edit opens a separate copy in Calibre. Export reads the Apple Books original. Existing export files are overwritten.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉnh sửa sẽ mở một bản sao riêng trong Calibre. Xuất sẽ đọc bản gốc từ Apple Books. Các tệp xuất hiện có sẽ bị ghi đè."
          }
        }
      }
    },
    "Edit: %lld opened · %lld failed.": {
